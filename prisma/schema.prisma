generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String   @id @default(cuid())
  email                String?  @unique
  phone                String?  @unique
  password             String?
  firstName            String?
  lastName             String?
  role                 String   @default("USER")
  isActive             Boolean  @default(true)
  refreshToken         String?
  fcmToken             String?
  otpHash              String?
  otpExpiresAt         DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // ── Performance indexes ─────────────────────────────────────
  // Index on role for ADMIN/USER filtering in admin endpoints
  @@index([role])
  // Composite index for OTP verification: look up by hash + expiry check
  @@index([otpHash, otpExpiresAt])
  // Index on isActive for potential filtering of active/inactive users
  @@index([isActive])
  // Index on passwordResetExpires for reset token expiry queries
  @@index([passwordResetExpires])
}

