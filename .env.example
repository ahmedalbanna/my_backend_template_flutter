# ── Application ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"

# ── JWT ─────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: In production, generate cryptographically random secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string-min-32"
JWT_REFRESH_EXPIRES_IN="7d"
