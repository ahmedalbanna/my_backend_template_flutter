# ── Application ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"

# ── JWT ─────────────────────────────────────────────────────────
