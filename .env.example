# ── Application ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/template_db?schema=public"
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-min-16-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string-min-16-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email (SMTP) ─────────────────────────────────────────────────
# Supports Gmail, Outlook, Mailgun, SendGrid, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Your App <noreply@yourapp.com>"

# ── Redis (for Bull Queue) ────────────────────────────────────────
# Required for background job processing (email queue, image processing)
REDIS_HOST="localhost"
REDIS_PORT=6379

# ── File Upload ──────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE=10485760
